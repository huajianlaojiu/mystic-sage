# === Supabase ===
# 去 https://supabase.com 注册 → 建 project → 拿到下面两个值
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# === OpenAI ===
# 去 https://platform.openai.com/api-keys 拿 key
# 如果在国内用香港代理转发，改 BASE_URL
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com

# === Lemon Squeezy ===
# 去 https://lemonsqueezy.com 注册 → Settings → API Keys
LEMONSQUEEZY_API_KEY=your-lemon-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# === PayPal IPN verification ===
# "sandbox" -> verify against PayPal's sandbox (ipnpb.sandbox.paypal.com).
# anything else (or unset) -> live (ipnpb.paypal.com).
# You can also override the URL directly with PAYPAL_IPN_VERIFY_URL.
PAYPAL_MODE=live
# The PayPal account that receives payments. Override with the sandbox
# facilitator email (e.g. xxx-facilitator@...com) when testing in sandbox.
PAYPAL_BUSINESS_EMAIL=mountain0342@gmail.com
# Full override of the verification endpoint (rarely needed).
PAYPAL_IPN_VERIFY_URL=https://ipnpb.paypal.com/cgi-bin/webscr
# Set to "true" ONLY in local dev to simulate IPNs without hitting PayPal.
# NEVER set this in production — it disables spoof protection.
PAYPAL_IPN_SKIP_VERIFY=false

# 在 Lemon Squeezy 后台创建产品后，把 variant ID 填到这里
LS_VARIANT_PLUS_MONTHLY=
LS_VARIANT_PLUS_ANNUAL=
LS_VARIANT_PREMIUM_MONTHLY=
LS_VARIANT_PREMIUM_ANNUAL=
LS_VARIANT_BIRTH_CHART=
LS_VARIANT_ANNUAL_FORECAST=
LS_VARIANT_COUPLES_COMPAT=

# === Email (Resend) ===
# 去 https://resend.com 注册 → API Keys 拿 key
# 建议验证域名后把 EMAIL_FROM 改成你的域名邮箱；未验证域名时用 onboarding@resend.dev 测试
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=MysticSage <onboarding@resend.dev>
EMAIL_REPLY_TO=mountain0342@gmail.com
