# MysticSage environment template.
# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production. Never commit real values.

# === Supabase ===
# Project settings -> API. The service role key is server-only: it bypasses RLS,
# so it must never be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI provider ===
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com
# Both tiers currently default to gpt-4o-mini. Point MODEL_PREMIUM at a
# stronger model when the margin allows it.
MODEL_FREE=gpt-4o-mini
MODEL_PREMIUM=gpt-4o-mini

# Optional second provider, used only when the primary call fails.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# === PayPal ===
# "sandbox" routes buttons and IPN verification to PayPal's sandbox.
PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_MODE=live
# The account that receives the money. The webhook rejects any IPN whose
# receiver_email does not match this.
PAYPAL_BUSINESS_EMAIL=your-paypal-business-email
NEXT_PUBLIC_PAYPAL_BUSINESS_EMAIL=your-paypal-business-email
PAYPAL_IPN_VERIFY_URL=https://ipnpb.paypal.com/cgi-bin/webscr
# Local development only. Never set this to true in production - it disables
# the verification that stops forged IPNs.
PAYPAL_IPN_SKIP_VERIFY=false

# === Email (Resend) ===
# Verify your sending domain in Resend first, then set EMAIL_FROM to an address
# on that domain. While the domain is unverified you can only send to your own
# account address using onboarding@resend.dev.
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=MysticSage <noreply@your-domain.com>
EMAIL_REPLY_TO=your-support-address
# Where "something went wrong with a payment" alerts are sent.
OWNER_ALERT_EMAIL=your-alert-address

# === Abuse prevention ===
# Any long random string. Salts the anonymous-usage fingerprints. If unset the
# service role key is used instead, which is worse because rotating that key
# would reset every counter.
RATE_LIMIT_SALT=your-long-random-salt

# === Analytics ===
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
